FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o whatsapp-proxy ./cmd/proxy

FROM alpine:3.21

RUN addgroup -S proxy && adduser -S proxy -G proxy

WORKDIR /app

COPY --from=builder /app/whatsapp-proxy .

USER proxy

ENTRYPOINT ["./whatsapp-proxy"]
CMD ["-config", "/app/config.yaml"]
